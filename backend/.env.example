NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://ai_voice_user:password@localhost:3306/ai_voice_platform
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
AUTH_COOKIE_SECURE=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_FINE_TUNE_MODEL=gpt-4.1-mini-2025-04-14
VOICE_RUNTIME=mock
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
VOICE_ACCENT=indian
# Voices tuned for Realtime: marin, cedar, shimmer, coral. Use VOICE_ACCENT=neutral to disable Indian accent prompts.
# Override voice agent behavior (language, greeting, scripts). Example:
# OPENAI_REALTIME_INSTRUCTIONS=You are a Tata voice assistant. Always respond in Hindi unless the caller speaks English. Wait for the caller before speaking. Keep replies under 2 sentences.
# OPENAI_REALTIME_TURN_DETECTION=server_vad
# VOICE_AUDIO_GAIN=2.0
# VOICE_AUDIO_AUTO_NORMALIZE=true
# VOICE_OUTBOUND_CHUNK_BYTES=800
# VOICE_DEBUG_SYNTHETIC_TONE=false
# VOICE_DEBUG_AUDIO=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
CORS_ORIGIN=http://localhost:5173
REDIS_ENABLED=true
SEED_DEV_INTEGRATION_API_KEY=false
APP_VERSION=0.1.0
# Optional label when multiple app servers share one Smartflo account
# APP_SERVER_ID=prod-api-1
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TEST_ENABLED=false
VOICE_RECORDINGS_STORAGE_DRIVER=local
VOICE_RECORDINGS_STORAGE_PATH=storage
# VOICE_RECORDINGS_S3_BUCKET=
# VOICE_WSS_BASE_URL=wss://your-domain/api/voice/stream
SMARTFLO_CLICK_TO_CALL_API_KEY=
SMARTFLO_BASE_URL=https://api-smartflo.tatateleservices.com
SMARTFLO_CALLER_ID=
# When true, only app-initiated Smartflo streams get OpenAI, recording, and session listing.
# Defaults to true in production and false in development.
# VOICE_REQUIRE_APP_AUTHORIZATION=false
# Call opening defaults (used for app-initiated outbound calls)
# VOICE_AGENT_NAME=Aisha
# VOICE_COMPANY_NAME=TATD
# VOICE_CALL_PURPOSE=to discuss your interest in our services
# VOICE_OPENING_GREETING=Namaste
VOICE_OPENING_GREETING_AUTO_TIME=true
# VOICE_ASK_PERMISSION_BEFORE_PITCH=true
VOICE_OPENING_IGNORE_MS=200
VOICE_POST_OPENING_IGNORE_MS=300
VOICE_OPENING_SPEECH_GATE_MAX_MS=300
VOICE_SPEECH_DETECTION_ENABLED=true
VOICE_SPEECH_RMS_THRESHOLD=0.01
VOICE_SPEECH_MIN_PACKETS=2
VOICE_SPEECH_MIN_DURATION_MS=80
VOICE_RECENT_SPEECH_MAX_AGE_MS=2500
VOICE_AUTO_END_CALL_ENABLED=true
VOICE_AUTO_END_CALL_DELAY_MS=1500
VOICE_AUTO_END_CALL_MAX_WAIT_MS=6000
VOICE_AGENT_PLAYBOOK_ENABLED=true
VOICE_AGENT_PLAYBOOK_CACHE_TTL_SECONDS=60
VOICE_AGENT_PLAYBOOK_FAIL_OPEN=true

# Voice transcript (Hindi + English / Hinglish)
VOICE_TRANSCRIPT_ENABLED=true
VOICE_TRANSCRIPT_MODE=realtime_and_postcall
VOICE_TRANSCRIPT_LANGUAGE_HINT=hi,en
VOICE_TRANSCRIPT_PRESERVE_HINGLISH=true
VOICE_TRANSCRIPT_POSTCALL_MODEL=gpt-4o-transcribe
VOICE_TRANSCRIPT_REALTIME_MODEL=gpt-4o-mini-transcribe
VOICE_TRANSCRIPT_POSTPROCESS_ENABLED=true
# VOICE_TRANSCRIPT_GLOSSARY=TATD,Smartflo,OpenAI,Realtime,AI Voice Calling Platform

# Training upload transcription (Hindi / English / Hinglish)
TRAINING_TRANSCRIPTION_MODEL=gpt-4o-transcribe
TRAINING_TRANSCRIPT_POSTPROCESS_ENABLED=true
TRAINING_TRANSCRIPT_PRESERVE_HINGLISH=true
# TRAINING_TRANSCRIPT_GLOSSARY=TATD,Smartflo,OpenAI

# Training call intelligence (LLM analysis of uploaded transcripts)
TRAINING_CALL_ANALYSIS_ENABLED=true
TRAINING_CALL_ANALYSIS_MODEL=gpt-4o
TRAINING_CALL_ANALYSIS_BATCH_SIZE=5
TRAINING_INSIGHTS_MODEL=gpt-4o

# Email transcript delivery
TRANSCRIPT_EMAIL_ENABLED=false
TRANSCRIPT_EMAIL_TO=sales@example.com,manager@example.com
TRANSCRIPT_EMAIL_CC=
TRANSCRIPT_EMAIL_BCC=
TRANSCRIPT_EMAIL_FROM=no-reply@tatdai.in
TRANSCRIPT_EMAIL_SUBJECT_PREFIX=Call Transcript
TRANSCRIPT_EMAIL_INCLUDE_SUMMARY=true
TRANSCRIPT_EMAIL_INCLUDE_RECORDING_LINK=true
TRANSCRIPT_EMAIL_INCLUDE_DASHBOARD_LINK=true
TRANSCRIPT_EMAIL_SEND_FOR_AUTHORIZED_ONLY=true
TRANSCRIPT_EMAIL_ATTACH_TXT=false
FRONTEND_APP_URL=https://tatdai.in

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tatdai.in
